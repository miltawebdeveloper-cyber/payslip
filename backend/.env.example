# Server
PORT=5000
NODE_ENV=development

# Allowed origin for the frontend (comma separated for multiple)
CORS_ORIGIN=http://localhost:5173

# Required. Salary records are stored in a Google Sheet (there is no database),
# read and written through the Apps Script Web App in google-apps-script/Code.gs.
# Deploy it with "Who has access: Anyone" and paste its /exec URL here.
GOOGLE_APPS_SCRIPT_URL=
# Recommended: the same value as the API_KEY Script Property in the Apps Script
# (Project Settings > Script Properties). Without it, anyone who has the URL
# can read the salary sheet.
GOOGLE_APPS_SCRIPT_KEY=

# Drive folder that holds the spreadsheet and the Payslips folder
GOOGLE_DRIVE_MAIN_FOLDER=Payslip Generator
GOOGLE_DRIVE_MAIN_FOLDER_ID=1wiDLZP-38rH7Nqtg_BQBYDayOWJ_UTgM
GOOGLE_SHEET_TITLE=Payslip Generator - Salary Records

# Company details shown on every generated payslip
COMPANY_NAME=Milta Accounting Services Pvt.Ltd
COMPANY_ADDRESS=No 175, Sri Sai Tower, 3rd floor, Bharathi Colony Rd, Peelamedu, Coimbatore, Tamil Nadu 641004
COMPANY_PHONE=+91 9600103723
# Optional image URL. Leave blank to use the bundled logo (src/assets/logo.svg).
COMPANY_LOGO_URL=
