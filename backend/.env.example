# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection (Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payslip_generator
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# PostgreSQL connection (Vercel / Cloud Database e.g. Neon, Supabase, Vercel Postgres)
# If DATABASE_URL or POSTGRES_URL is provided, it takes precedence over DB_HOST/DB_USER etc.
# DATABASE_URL=postgres://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Allowed origin for the frontend (comma separated for multiple)
CORS_ORIGIN=http://localhost:5173

# Google Account Integration without Google Cloud (Zero GCP Setup)
GOOGLE_APPS_SCRIPT_URL=

# Google Drive folder customization
GOOGLE_DRIVE_MAIN_FOLDER=Payslip Generator
GOOGLE_DRIVE_MAIN_FOLDER_ID=1wiDLZP-38rH7Nqtg_BQBYDayOWJ_UTgM
GOOGLE_SHEET_TITLE=Payslip Generator - Salary Records

# Company details shown on every generated payslip
COMPANY_NAME=Milta Accounting Services Pvt.Ltd
COMPANY_ADDRESS=No 175, Sri Sai Tower, 3rd floor, Bharathi Colony Rd, Peelamedu, Coimbatore, Tamil Nadu 641004
COMPANY_PHONE=+91 9600103723
# Optional image URL. Leave blank to use the bundled logo (src/assets/logo.svg).
COMPANY_LOGO_URL=




